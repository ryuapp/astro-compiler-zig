{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/*.ts",
    "test/tsx-upstream/**/*.ts",
    "test/compiler-upstream/**/*.ts",
    "test/tsx-upstream-api/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "forks",
    "zig-pkg",
    "node_modules",
    ".zig-cache",
    ".tmp",
    "zig-out",
    "dist",
    "test/compiler-upstream/expected-fails"
  ]
}
